{
    "manifest_version": 3,
    "name": "LaTeX Email Renderer",
    "version": "1.0.0",
    "description": "Write and render LaTeX equations in gmail.",

    "permissions": ["activeTab"],

    "content_scripts": [
        {
            "matches": [
                "https://mail.google.com/*",
                "https://outlook.live.com/*"
            ],
            "js": ["content.js",
                    "libs/katex.min.js"],

            "css": ["style.css",
                    "libs/katex.min.css"]
        }
    ],

    "web_accessible_resources": [
        {
            "resources": ["libs/fonts/*"],
            "matches": [
                "https://mail.google.com/*",
                "https://outlook.live.com/*"
            ]
        }
    ]
}